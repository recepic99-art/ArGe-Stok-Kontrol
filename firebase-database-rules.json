{
  "rules": {
    "appState": {
      ".read": "auth != null",
      "schemaVersion": {
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      },
      "tables": {
        ".write": "auth != null"
      },
      "logs": {
        ".write": "auth != null"
      },
      "definitions": {
        ".write": "auth != null && root.child('appState/rolesByUid').child(auth.uid).val() == 'admin'"
      },
      "userDirectory": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['id', 'authUid', 'username', 'name']) && newData.child('authUid').val() == $uid && newData.child('username').isString() && newData.child('name').isString()"
        }
      },
      "rolesByUid": {
        "$uid": {
          ".write": "auth != null && (root.child('appState/rolesByUid').child(auth.uid).val() == 'admin' || (auth.uid == $uid && !data.exists() && newData.val() == 'member') || (auth.uid == $uid && !data.parent().hasChildren() && newData.val() == 'admin'))",
          ".validate": "newData.val() == 'admin' || newData.val() == 'member'"
        }
      }
    }
  }
}
